---
/**
 * One facet group's values as a row of toggle chips (the group's name lives on its
 * tab in SearchFilter.astro). The bundled script in SearchFilter.astro wires clicks
 * via the data attributes and reflects state in `aria-pressed`; styling keys off
 * that attribute so the chips need no JS to look right and stay accessible.
 */
import type { FacetGroup } from '../lib/search';
import { facetIconName } from '../lib/icons';
import Icon from './Icon.astro';

interface Props {
  group: FacetGroup;
}
const { group } = Astro.props;
const icon = facetIconName(group.key);
---

<div role="group" aria-label={group.label} class="flex flex-wrap items-center gap-1.5">
  {
    group.values.map((v) => (
      <button
        type="button"
        data-facet-group={group.key}
        data-facet-value={v.value}
        aria-pressed="false"
        aria-label={`${v.label}, ${v.count} ${v.count === 1 ? 'recipe' : 'recipes'}`}
        class="group/chip inline-flex items-center gap-1.5 rounded-full border border-line bg-card px-3 py-1 font-ui text-sm text-ink-soft transition-colors hover:border-spice hover:text-spice aria-pressed:border-spice aria-pressed:bg-spice aria-pressed:text-paper"
      >
        {icon && (
          <Icon
            name={icon}
            class="h-3 w-3 shrink-0 text-ink-faint group-aria-pressed/chip:text-paper/75"
          />
        )}
        {v.label}
        <span aria-hidden="true" class="font-ui text-xs text-ink-faint tabular-nums group-aria-pressed/chip:text-paper/75">
          {v.count}
        </span>
      </button>
    ))
  }
</div>
